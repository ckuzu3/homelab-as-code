---
# Managed by Ansible. Edit roles/monitoring/templates/alert-rules.yml.j2 instead.
groups:
  - name: homelab
    rules:
      - alert: TargetDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.job }}' }} on {{ '{{ $labels.instance }}' }} is not answering"
          description: >-
            Prometheus has had no successful scrape for five minutes. Check the container
            before trusting any other alert about this target.

      - alert: HostDiskFillingUp
        expr: >-
          node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"} < 0.10
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.mountpoint }}' }} is below 10 percent free"
          description: >-
            Container logs and image layers are the usual cause. The Docker daemon in this
            stack rotates logs, so an image prune is the first thing to try.

      - alert: HostOutOfMemory
        expr: >-
          node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Less than 10 percent memory available on {{ '{{ $labels.instance }}' }}"
          description: >-
            Fifteen minutes, because a build or a backup may legitimately take the machine
            to its limit for a few minutes.
