---
# Managed by Ansible. Edit roles/monitoring/templates/prometheus.yml.j2 instead.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/alert-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
    # The service name, not an address. Compose resolves it on the stack's own network,
    # so nothing here changes when the host's address does.

  # A Windows client running windows-health-exporter would be added like this:
  # - job_name: windows-health
  #   static_configs:
  #     - targets: ["ws-0001.lan:9183"]
